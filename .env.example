# Neon PostgreSQL Database Connection (Required - Neon Free Tier via Drizzle ORM)
# Format: postgresql://<user>:<password>@<endpoint>.neon.tech/<dbname>?sslmode=require
DATABASE_URL=

# Nebius Token Factory (Official Nebius × NVIDIA Global AI Hackathon Integration)
# Model: NVIDIA Nemotron-3-Nano-30B-A3B (official shared inference endpoint)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-3-nano-30b-a3b

# Google Gemini API Key (Alternative AI Provider for dual-engine support)
GEMINI_API_KEY=

# Firebase Authentication Client Configuration (Provided via environment variables / secrets)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin / Backend Token Verification Configuration
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_KEY=

# GitHub API (Optional Free Personal Access Token - increases rate limit from 60 to 5,000 req/hr)
GITHUB_TOKEN=

# Cloudinary Free Tier (Optional - only used if cloud archive export is requested)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
