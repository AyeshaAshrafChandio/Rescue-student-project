{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated user profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Project": {
      "title": "Project",
      "description": "Student project tracked for rescue",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "sourceType": { "type": "string", "enum": ["zip", "github"] },
        "repoUrl": { "type": "string" },
        "githubBranch": { "type": "string" },
        "requirementsText": { "type": "string" },
        "targetTechStack": { "type": "string" },
        "deadline": { "type": "string" },
        "healthScore": { "type": "number" },
        "progressPercent": { "type": "number" },
        "status": { "type": "string", "enum": ["created", "analyzing", "ready", "in_rescue", "completed", "failed"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "ownerId", "title", "sourceType", "status"]
    },
    "ProjectFile": {
      "title": "ProjectFile",
      "description": "Actual extracted or fetched project source file",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "filePath": { "type": "string" },
        "content": { "type": "string" },
        "size": { "type": "number" },
        "language": { "type": "string" },
        "isModified": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "projectId", "filePath"]
    },
    "AnalysisReport": {
      "title": "AnalysisReport",
      "description": "Deep codebase inspection result comparing code to student requirements",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "techDetected": { "type": "string" },
        "requirementsSummary": { "type": "string" },
        "healthScore": { "type": "number" },
        "overallSummary": { "type": "string" },
        "featuresDoneJson": { "type": "string" },
        "featuresBrokenJson": { "type": "string" },
        "featuresMissingJson": { "type": "string" },
        "featuresUnverifiableJson": { "type": "string" },
        "issuesListJson": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "projectId", "healthScore"]
    },
    "RescueTask": {
      "title": "RescueTask",
      "description": "Prioritized actionable step in the project rescue plan",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "taskOrder": { "type": "number" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "priority": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
        "status": { "type": "string", "enum": ["pending", "in_progress", "under_review", "applied", "verified", "failed"] },
        "description": { "type": "string" },
        "targetFiles": { "type": "string" },
        "rootCauseAnalysis": { "type": "string" },
        "proposedChanges": { "type": "string" },
        "testCommand": { "type": "string" },
        "verificationOutput": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "projectId", "taskOrder", "title", "priority", "status"]
    },
    "VerificationRun": {
      "title": "VerificationRun",
      "description": "Real build, test or syntax execution verification record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "taskId": { "type": "string" },
        "runType": { "type": "string" },
        "status": { "type": "string", "enum": ["passed", "failed"] },
        "stdout": { "type": "string" },
        "stderr": { "type": "string" },
        "durationMs": { "type": "number" },
        "checkedAt": { "type": "string" }
      },
      "required": ["id", "projectId", "taskId", "status"]
    },
    "AiSessionMessage": {
      "title": "AiSessionMessage",
      "description": "Conversation message in AI Rescue Workspace with Bob 2.0",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "taskId": { "type": "string" },
        "sender": { "type": "string", "enum": ["user", "bob_ai"] },
        "text": { "type": "string" },
        "diffPayload": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "projectId", "sender", "text"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Student rescue project documents"
    },
    "/projects/{projectId}/files/{fileId}": {
      "schema": "ProjectFile",
      "description": "Source files belonging to a project"
    },
    "/projects/{projectId}/reports/{reportId}": {
      "schema": "AnalysisReport",
      "description": "Codebase analysis reports for a project"
    },
    "/projects/{projectId}/tasks/{taskId}": {
      "schema": "RescueTask",
      "description": "Rescue tasks in the project plan"
    },
    "/projects/{projectId}/verifications/{verificationId}": {
      "schema": "VerificationRun",
      "description": "Verification runs for a task"
    },
    "/projects/{projectId}/messages/{messageId}": {
      "schema": "AiSessionMessage",
      "description": "AI Workspace messages for this project"
    }
  }
}
