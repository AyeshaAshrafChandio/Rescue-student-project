rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default-deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isProjectOwner(projectId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/projects/$(projectId)) &&
        get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
    }

    // User profiles: owner only
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow delete: if false;
    }

    // Projects collection
    match /projects/{projectId} {
      allow get: if isSignedIn() && (resource == null || resource.data.ownerId == request.auth.uid);
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(projectId) && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      // Project subcollections: strictly derived from parent project ownership
      match /files/{fileId} {
        allow read, write: if isProjectOwner(projectId);
      }

      match /reports/{reportId} {
        allow read, write: if isProjectOwner(projectId);
      }

      match /tasks/{taskId} {
        allow read, write: if isProjectOwner(projectId);
      }

      match /verifications/{verificationId} {
        allow read, write: if isProjectOwner(projectId);
      }

      match /messages/{messageId} {
        allow read, write: if isProjectOwner(projectId);
      }
    }
  }
}
